# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ROUTER_MODEL=gemini-3.1-flash-lite
AGENT_MODEL=gemini-3.1-flash-lite
AGENT_MODEL_FAST=
AGENT_MODEL_STRONG=
CHECKLIST_MODEL=gemini-3.1-flash-lite

# OpenRouter - free model picker (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

DATABASE_URL=sqlite:///./aio.db
API_BASE_URL=http://127.0.0.1:8000
GENERAL_STATUS_POSTS=false
GITHUB_WEBHOOK_SECRET=dev-secret
GITHUB_TOKEN=
GITHUB_REPO=
# squash | merge | rebase - used by "Merge & done"
MERGE_METHOD=squash
DEMO_API_KEY=demo-key-a
DEMO_API_KEY_B=demo-key-b
WORKSPACE_JOIN_KEY=demo-key-a
CODING_BACKEND=llm
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
AGENT_LLM_BACKEND=auto
GROQ_API_KEY=
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=austin
GROQ_STT_MODEL=whisper-large-v3-turbo
TTS_DIR=data/tts
UPLOADS_DIR=data/uploads
AGENT_WORK_ROOT=data/workspaces
AGENT_GIT_TIMEOUT_SECONDS=120

# DeepResearch live sources (https://tavily.com). Empty = no citations, never invented links.
TAVILY_API_KEY=
RESEARCH_MAX_RESULTS=6
RESEARCH_FETCH_TIMEOUT_SECONDS=20
RESEARCH_MAX_PAGE_CHARS=20000

# Agentic coding CLIs (npm i -g @openai/codex ; npm i -g @anthropic-ai/claude-code)
# CODING_BACKEND: llm | opencode | codex | claude_code
CODEX_BIN=codex
CODEX_TIMEOUT_SECONDS=900
CODEX_SANDBOX=workspace-write
CODEX_API_KEY=
CLAUDE_BIN=claude
CLAUDE_TIMEOUT_SECONDS=900
CLAUDE_PERMISSION_MODE=acceptEdits
ANTHROPIC_API_KEY=

# Owner TUI refresh interval
TUI_POLL_SECONDS=2.0

# Public base for invite links (members open /join/{token} and register)
INVITE_APP_URL=http://YOUR_LAN_IP:8000

# Invite emails: only this domain may be invited / register via invite link.
# Empty = unrestricted (local demo). Production default is tatweermea.com.
INVITE_ALLOWED_DOMAIN=tatweermea.com

# Free Outlook Web invites via Playwright (no SMTP / no billing).
# One-time: pip install playwright && playwright install chromium
#           aio outlook-login
OUTLOOK_INVITE_ENABLED=true
OUTLOOK_STORAGE_STATE=data/outlook_auth.json
# false = show Chromium while sending (true = silent/background)
OUTLOOK_HEADLESS=false

# Microsoft Teams Incoming Webhook URL (optional). When set, !invite posts the link to the channel.
# Teams channel → ••• → Connectors / Workflows → Incoming Webhook → paste full URL here:
TEAMS_WEBHOOK_URL=
